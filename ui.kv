#:kivy 2.1

<EntryButton@Button>:
    path: ''
    kind: ''
    size_hint_y: None
    height: '34dp'
    font_size: '13sp'
    halign: 'left'
    valign: 'middle'
    padding: '6dp', '2dp'
    text_size: self.width - dp(12), None
    shorten: True
    shorten_from: 'right'
    background_normal: ''
    background_color: (0.15, 0.16, 0.2, 1) if self.kind != 'file' else (0.11, 0.12, 0.15, 1)
    color: (0.75, 0.85, 1, 1) if self.kind == 'up' else ((0.95, 0.9, 0.6, 1) if self.kind == 'dir' else (0.9, 0.92, 0.95, 1))
    on_release: app.entry_clicked(self.path, self.kind)

<FileTree>:
    orientation: 'vertical'
    spacing: '2dp'
    canvas.before:
        Color:
            rgba: 0.09, 0.09, 0.12, 1
        Rectangle:
            pos: self.pos
            size: self.size
    Label:
        text: root.path
        size_hint_y: None
        height: '24dp'
        font_size: '10sp'
        color: 0.55, 0.6, 0.7, 1
        padding: '6dp', '2dp'
        text_size: self.width - dp(12), None
        shorten: True
        shorten_from: 'left'
        halign: 'left'
    RecycleView:
        id: rv
        viewclass: 'EntryButton'
        data: root.entries
        bar_width: '4dp'
        RecycleBoxLayout:
            default_size: None, dp(34)
            default_size_hint: 1, None
            size_hint_y: None
            height: self.minimum_height
            orientation: 'vertical'

<CodeArea>:
    font_name: 'RobotoMono-Regular' if app.has_mono else 'Roboto'
    font_size: app.font_size
    background_color: 0.07, 0.08, 0.1, 1
    foreground_color: 0.92, 0.94, 0.98, 1
    cursor_color: 0.4, 0.9, 0.6, 1
    tab_width: 4
    auto_indent: True

<OutLabel@Label>:
    size_hint_y: None
    height: max(self.texture_size[1] + dp(8), self.parent.height if self.parent else dp(10))
    text_size: self.width - dp(12), None
    font_size: '12sp'
    font_name: 'RobotoMono-Regular' if app.has_mono else 'Roboto'
    color: 0.85, 0.9, 0.95, 1
    padding: '6dp', '4dp'
    valign: 'top'
    halign: 'left'
    markup: True

<RootUI>:
    orientation: 'vertical'
    canvas.before:
        Color:
            rgba: 0.06, 0.06, 0.08, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:  # ---------- 工具条 ----------
        size_hint_y: None
        height: '46dp'
        spacing: '3dp'
        padding: '3dp'
        Button:
            text: '▶ 运行'
            font_size: '14sp'
            background_normal: ''
            background_color: 0.13, 0.45, 0.28, 1
            on_release: app.do_run()
        Button:
            text: '■ 停止'
            font_size: '14sp'
            background_normal: ''
            background_color: 0.5, 0.18, 0.18, 1
            on_release: app.do_stop()
        Button:
            text: '＋'
            size_hint_x: 0.35
            font_size: '16sp'
            on_release: app.do_new()
        Button:
            text: '💾'
            size_hint_x: 0.35
            font_size: '16sp'
            on_release: app.do_save()
        Button:
            text: '↻'
            size_hint_x: 0.3
            font_size: '16sp'
            on_release: app.do_refresh()

    BoxLayout:  # ---------- 三栏 ----------
        FileTree:
            id: tree
            size_hint_x: 0.32
            path: app.root_path
        BoxLayout:
            orientation: 'vertical'
            BoxLayout:
                size_hint_y: None
                height: '30dp'
                TextInput:
                    id: fname
                    hint_text: '文件名.py'
                    multiline: False
                    font_size: '12sp'
                    background_color: 0.12, 0.12, 0.16, 1
                    foreground_color: 0.9, 0.92, 0.96, 1
                    padding: '6dp', '5dp'
                Button:
                    text: '🗑'
                    size_hint_x: None
                    width: '34dp'
                    font_size: '14sp'
                    on_release: app.do_delete()
                Button:
                    text: 'A-'
                    size_hint_x: None
                    width: '34dp'
                    font_size: '12sp'
                    on_release: app.zoom(-1)
                Button:
                    text: 'A+'
                    size_hint_x: None
                    width: '34dp'
                    font_size: '12sp'
                    on_release: app.zoom(1)
            CodeArea:
                id: code
                size_hint_y: 0.62
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: 0.38
                Label:
                    text: '输出'
                    size_hint_y: None
                    height: '20dp'
                    font_size: '11sp'
                    color: 0.5, 0.55, 0.65, 1
                    text_size: self.width, None
                    halign: 'left'
                    padding: '6dp', '0dp'
                ScrollView:
                    id: outsv
                    bar_width: '4dp'
                    OutLabel:
                        id: out
                        text: app.out_text
